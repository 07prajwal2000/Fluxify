{
	"name": "@fluxify/ai-gateway",
	"module": "src/index.ts",
	"type": "module",
	"private": true,
	"devDependencies": {
		"@fluxify/adapters": "workspace:*",
		"@types/bun": "^1.4.0",
		"@types/dockerode": "^4.0.1",
		"dockerode": "^4.0.9"
	},
	"scripts": {
		"dev": "bun --watch run src/server.ts",
		"build": "bun build src/server.ts --outdir=./dist --bundle --target bun --minify --sourcemap=linked --conditions=module",
		"gather": "bun ./src/scripts/gather.ts",
		"typecheck": "tsgo --noEmit",
		"test": "bun test --parallel"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.0",
		"@ai-sdk/google": "^4.0.0",
		"@ai-sdk/mistral": "^4.0.0",
		"@ai-sdk/openai": "^4.0.0",
		"@ai-sdk/openai-compatible": "^3.0.0",
		"@fluxify/blocks": "workspace:*",
		"@fluxify/common": "workspace:*",
		"@fluxify/lib": "workspace:*",
		"@fluxify/server": "workspace:*",
		"@hono/mcp": "^0.3.0",
		"@hono/zod-validator": "^0.8.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@orama/plugin-data-persistence": "^3.1.18",
		"ai": "^7.0.0",
		"drizzle-orm": "0.45.3",
		"hono": "^4.12.27",
		"zod": "^4.4.3"
	}
}
