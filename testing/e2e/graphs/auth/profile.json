{
	"name": "auth/profile",
	"description": "GET /auth/profile — verifies the bearer token, then reads the account the token's sub points at. The profile comes from the database, not from the claims.",
	"engine": "pg",
	"route": {
		"method": "GET",
		"path": "/auth/profile"
	},
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": {
				"x": 0,
				"y": 0
			},
			"data": {
				"blockName": "Request"
			}
		},
		{
			"id": "verify-token",
			"type": "jsrunner",
			"position": {
				"x": 240,
				"y": 0
			},
			"data": {
				"blockName": "Verify the bearer token",
				"value": "const header = getHeader(\"authorization\");\nreturn jwt.verify(header.replace(/^Bearer\\s+/i, \"\"), \"e2e-jwt-secret\", { issuer: \"fluxify-e2e\" });"
			}
		},
		{
			"id": "authenticated",
			"type": "if",
			"position": {
				"x": 480,
				"y": 0
			},
			"data": {
				"blockName": "Token valid?",
				"conditions": [
					{
						"lhs": "js:return input.success;",
						"rhs": true,
						"operator": "eq",
						"chain": "and"
					}
				]
			}
		},
		{
			"id": "load-profile",
			"type": "db_getsingle",
			"position": {
				"x": 720,
				"y": -120
			},
			"data": {
				"blockName": "Read the account",
				"connection": "primary",
				"tableName": "auth_users",
				"conditions": [
					{
						"attribute": "id",
						"operator": "eq",
						"value": "js:return Number(input.payload.sub);",
						"chain": "and"
					}
				],
				"columns": [
					"id",
					"username",
					"email"
				]
			}
		},
		{
			"id": "profile",
			"type": "response",
			"position": {
				"x": 960,
				"y": -120
			},
			"data": {
				"blockName": "200 OK",
				"httpCode": "200"
			}
		},
		{
			"id": "anonymous-body",
			"type": "jsrunner",
			"position": {
				"x": 720,
				"y": 120
			},
			"data": {
				"blockName": "Unauthenticated payload",
				"value": "return { error: \"unauthenticated\" };"
			}
		},
		{
			"id": "anonymous",
			"type": "response",
			"position": {
				"x": 960,
				"y": 120
			},
			"data": {
				"blockName": "401 Unauthorized",
				"httpCode": "401"
			}
		}
	],
	"edges": [
		{
			"id": "e-entry-verify",
			"from": "entry",
			"to": "verify-token",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-verify-check",
			"from": "verify-token",
			"to": "authenticated",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-check-load",
			"from": "authenticated",
			"to": "load-profile",
			"fromHandle": "success",
			"toHandle": "success"
		},
		{
			"id": "e-load-response",
			"from": "load-profile",
			"to": "profile",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-check-anonymous",
			"from": "authenticated",
			"to": "anonymous-body",
			"fromHandle": "failure",
			"toHandle": "failure"
		},
		{
			"id": "e-anonymous-response",
			"from": "anonymous-body",
			"to": "anonymous",
			"fromHandle": "source",
			"toHandle": "source"
		}
	]
}
