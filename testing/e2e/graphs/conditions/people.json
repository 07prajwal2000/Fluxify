{
	"name": "conditions/people",
	"description": "POST /people — lists the names of people matching one condition. The column and value come from the body; tests swap in the operator, so every operator runs through the real compiler and adapter with whatever a caller could send.",
	"engine": "pg",
	"route": { "method": "POST", "path": "/people" },
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "find",
			"type": "db_getall",
			"position": { "x": 240, "y": 0 },
			"data": {
				"blockName": "Find people",
				"connection": "primary",
				"tableName": "people",
				"conditions": [
					{
						"attribute": { "kind": "column", "value": "js:return getRequestBody().column;" },
						"operator": "eq",
						"value": { "kind": "literal", "value": "js:return getRequestBody().value;" },
						"chain": "and"
					}
				],
				"columns": ["name"],
				"limit": 100,
				"offset": 0,
				"sort": { "attribute": "id", "direction": "asc" }
			}
		},
		{
			"id": "reply",
			"type": "response",
			"position": { "x": 480, "y": 0 },
			"data": { "blockName": "200 OK", "httpCode": "200" }
		}
	],
	"edges": [
		{ "id": "e-entry-find", "from": "entry", "to": "find", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-find-reply", "from": "find", "to": "reply", "fromHandle": "source", "toHandle": "source" }
	]
}
