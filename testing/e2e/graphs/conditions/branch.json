{
	"name": "conditions/branch",
	"description": "POST /branch — an If block whose conditions each test replaces; `yes` or `no` runs depending on the answer.",
	"engine": "none",
	"route": {
		"method": "POST",
		"path": "/branch"
	},
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "check",
			"type": "if",
			"position": { "x": 240, "y": 0 },
			"data": { "blockName": "Check", "conditions": [] }
		},
		{
			"id": "yes",
			"type": "response",
			"position": { "x": 480, "y": -120 },
			"data": { "blockName": "True", "httpCode": "200" }
		},
		{
			"id": "no",
			"type": "response",
			"position": { "x": 480, "y": 120 },
			"data": { "blockName": "False", "httpCode": "200" }
		}
	],
	"edges": [
		{ "id": "e-entry-check", "from": "entry", "to": "check", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-check-yes", "from": "check", "to": "yes", "fromHandle": "success", "toHandle": "success" },
		{ "id": "e-check-no", "from": "check", "to": "no", "fromHandle": "failure", "toHandle": "failure" }
	]
}
