{
	"name": "conditions/filter",
	"description": "POST /filter — keeps the body's `items` that pass an Array Operations filter each test replaces, and replies with them.",
	"engine": "none",
	"route": {
		"method": "POST",
		"path": "/filter"
	},
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "items",
			"type": "setvar",
			"position": { "x": 240, "y": 0 },
			"data": { "blockName": "Items", "key": "items", "value": "js:return getRequestBody().items;" }
		},
		{
			"id": "keep",
			"type": "arrayops",
			"position": { "x": 480, "y": 0 },
			"data": { "blockName": "Keep", "operation": "filter", "datasource": "items", "filterConditions": [] }
		},
		{
			"id": "reply",
			"type": "response",
			"position": { "x": 720, "y": 0 },
			"data": { "blockName": "Kept", "httpCode": "200" }
		}
	],
	"edges": [
		{ "id": "e-entry-items", "from": "entry", "to": "items", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-items-keep", "from": "items", "to": "keep", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-keep-reply", "from": "keep", "to": "reply", "fromHandle": "source", "toHandle": "source" }
	]
}
