{
	"name": "send-message/bulk",
	"description": "POST /send/bulk — the request body's `messages` list, used as the payload, so each item is one message. Default policy: Failure runs only when every message failed.",
	"engine": "none",
	"route": { "method": "POST", "path": "/send/bulk" },
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "pick",
			"type": "jsrunner",
			"position": { "x": 200, "y": 0 },
			"data": { "blockName": "The list", "value": "return input.messages;" }
		},
		{
			"id": "send",
			"type": "queue_send",
			"position": { "x": 400, "y": 0 },
			"data": {
				"blockName": "Send the list",
				"connection": "js:return getQueryParam('connection')",
				"mode": "simple",
				"bulk": false,
				"destination": "js:return getQueryParam('destination')",
				"useParam": true,
				"failWhen": "all",
				"js": ""
			}
		},
		{
			"id": "sent",
			"type": "response",
			"position": { "x": 640, "y": -80 },
			"data": { "blockName": "200 Sent", "httpCode": "200" }
		},
		{
			"id": "failed",
			"type": "response",
			"position": { "x": 640, "y": 80 },
			"data": { "blockName": "500 Failed", "httpCode": "500" }
		}
	],
	"edges": [
		{ "id": "e-entry-pick", "from": "entry", "to": "pick", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-pick-send", "from": "pick", "to": "send", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-send-sent", "from": "send", "to": "sent", "fromHandle": "source", "toHandle": "success" },
		{ "id": "e-send-failed", "from": "send", "to": "failed", "fromHandle": "source", "toHandle": "failure" }
	]
}
