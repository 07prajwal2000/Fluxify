{
	"name": "send-message/single",
	"description": "POST /send — publishes the request body's `payload` to the integration and destination it names, then answers 200 with the broker's report or 500 with the failure.",
	"engine": "none",
	"route": { "method": "POST", "path": "/send" },
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "send",
			"type": "queue_send",
			"position": { "x": 240, "y": 0 },
			"data": {
				"blockName": "Send one message",
				"connection": "js:return input.connection",
				"mode": "simple",
				"bulk": false,
				"destination": "js:return input.destination",
				"useParam": false,
				"payload": { "source": "js", "value": "js:return input.payload" },
				"key": "js:return input.key",
				"headers": { "x-e2e": "single" },
				"options": { "msgId": "js:return input.msgId", "maxLen": "js:return input.maxLen" },
				"failWhen": "all",
				"js": ""
			}
		},
		{
			"id": "sent",
			"type": "response",
			"position": { "x": 480, "y": -80 },
			"data": { "blockName": "200 Sent", "httpCode": "200" }
		},
		{
			"id": "failed",
			"type": "response",
			"position": { "x": 480, "y": 80 },
			"data": { "blockName": "500 Failed", "httpCode": "500" }
		}
	],
	"edges": [
		{ "id": "e-entry-send", "from": "entry", "to": "send", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-send-sent", "from": "send", "to": "sent", "fromHandle": "source", "toHandle": "success" },
		{ "id": "e-send-failed", "from": "send", "to": "failed", "fromHandle": "source", "toHandle": "failure" }
	]
}
