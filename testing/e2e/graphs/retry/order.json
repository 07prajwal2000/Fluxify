{
	"name": "retry/order",
	"description": "POST /retry/orders — a Retry block around a transaction that inserts an order, then throws while the try count is at most body.failFor. Each failed try rolls its insert back; success replies 201 with the row, and failure (every try failed) replies 503 with { attempts, message }.",
	"engine": "pg",
	"route": { "method": "POST", "path": "/retry/orders" },
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "retry",
			"type": "retry",
			"position": { "x": 240, "y": 0 },
			"data": { "blockName": "Retry order", "maxRetries": "2", "retryType": "fixed", "delayMs": "10" }
		},
		{
			"id": "tx",
			"type": "db_transaction",
			"position": { "x": 240, "y": -240 },
			"data": { "blockName": "Place order", "connection": "primary", "executor": "insert-order" }
		},
		{
			"id": "insert-order",
			"type": "db_insert",
			"position": { "x": 240, "y": -480 },
			"data": {
				"blockName": "Insert order",
				"connection": "primary",
				"tableName": "orders",
				"useParam": false,
				"data": {
					"source": "js",
					"value": "const body = getRequestBody();\nreturn { user_id: body.user_id, total: body.total, status: \"pending\" };"
				}
			}
		},
		{
			"id": "flaky",
			"type": "jsrunner",
			"position": { "x": 480, "y": -480 },
			"data": {
				"blockName": "Fail the first tries",
				"value": "tries = (tries ?? 0) + 1;\nif (tries <= getRequestBody().failFor) throw new Error('flaky try ' + tries);\nreturn input;"
			}
		},
		{
			"id": "created",
			"type": "response",
			"position": { "x": 480, "y": 0 },
			"data": { "blockName": "201 Created", "httpCode": "201" }
		},
		{
			"id": "gave-up",
			"type": "response",
			"position": { "x": 480, "y": 120 },
			"data": { "blockName": "503 Gave up", "httpCode": "503" }
		}
	],
	"edges": [
		{ "id": "e-entry-retry", "from": "entry", "to": "retry", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-retry-tx", "from": "retry", "to": "tx", "fromHandle": "executor", "toHandle": "executor" },
		{ "id": "e-tx-insert", "from": "tx", "to": "insert-order", "fromHandle": "executor", "toHandle": "executor" },
		{ "id": "e-insert-flaky", "from": "insert-order", "to": "flaky", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-retry-created", "from": "retry", "to": "created", "fromHandle": "success", "toHandle": "success" },
		{ "id": "e-retry-gave-up", "from": "retry", "to": "gave-up", "fromHandle": "failure", "toHandle": "failure" }
	]
}
