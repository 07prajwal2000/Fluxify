{
	"name": "bulk-insert/all-or-nothing",
	"description": "POST /users/bulk — builds `count` users from the body and bulk inserts them in one transaction. With duplicateLast the last row repeats a seeded email, so the last chunk fails and nothing may stay behind.",
	"engine": "pg",
	"route": {
		"method": "POST",
		"path": "/users/bulk"
	},
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": {
				"x": 0,
				"y": 0
			},
			"data": {
				"blockName": "Request"
			}
		},
		{
			"id": "rows",
			"type": "jsrunner",
			"position": {
				"x": 240,
				"y": 0
			},
			"data": {
				"blockName": "Build rows",
				"value": "const body = getRequestBody();\nconst n = body.count; const prefix = body.prefix;\nconst rows = Array.from({ length: n }, (_, i) => ({ name: 'Bulk ' + i, email: prefix + i + '@bulk.io' }));\nif (body.duplicateLast) rows[n - 1] = { name: 'Dup', email: \"ada@example.com\" };\nreturn rows;"
			}
		},
		{
			"id": "insert",
			"type": "db_insertbulk",
			"position": {
				"x": 480,
				"y": 0
			},
			"data": {
				"blockName": "Bulk insert",
				"connection": "primary",
				"tableName": "users",
				"useParam": true,
				"useTransaction": true,
				"data": {
					"source": "raw",
					"value": []
				}
			}
		},
		{
			"id": "created",
			"type": "response",
			"position": {
				"x": 720,
				"y": 0
			},
			"data": {
				"blockName": "201",
				"httpCode": "201"
			}
		}
	],
	"edges": [
		{
			"id": "e-entry-rows",
			"from": "entry",
			"to": "rows",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-rows-insert",
			"from": "rows",
			"to": "insert",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-insert-created",
			"from": "insert",
			"to": "created",
			"fromHandle": "source",
			"toHandle": "source"
		}
	]
}
