{
	"name": "response/dynamic-status",
	"description": "POST /response/status — a Response block whose status code is a js: expression returning body.code. A known code (number or string) is sent with the body; anything else fails the block.",
	"engine": "none",
	"route": { "method": "POST", "path": "/response/status" },
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": { "x": 0, "y": 0 },
			"data": { "blockName": "Request" }
		},
		{
			"id": "body",
			"type": "httpgetrequestbody",
			"position": { "x": 240, "y": 0 },
			"data": { "blockName": "Body" }
		},
		{
			"id": "reply",
			"type": "response",
			"position": { "x": 480, "y": 0 },
			"data": { "blockName": "Reply", "httpCode": "js:return input.code;" }
		}
	],
	"edges": [
		{ "id": "e-entry-body", "from": "entry", "to": "body", "fromHandle": "source", "toHandle": "source" },
		{ "id": "e-body-reply", "from": "body", "to": "reply", "fromHandle": "source", "toHandle": "source" }
	]
}
