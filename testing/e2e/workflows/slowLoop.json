{
	"name": "slowLoop",
	"description": "Loops far longer than its timeout. Reports its start, and `after` past the loop, which a timeout must never reach.",
	"blocks": [
		{
			"id": "entry",
			"type": "entrypoint",
			"position": {
				"x": 0,
				"y": 0
			},
			"data": {
				"blockName": "Start"
			}
		},
		{
			"id": "start",
			"type": "jsrunner",
			"position": {
				"x": 240,
				"y": 0
			},
			"data": {
				"blockName": "Start",
				"value": "await fetch(getConfig(\"E2E_SINK_URL\") + \"/ev?k=\" + encodeURIComponent(input.k) + \"&e=start\");\nreturn Array.from({ length: 500 }, (_, i) => i);"
			}
		},
		{
			"id": "each",
			"type": "foreachloop",
			"position": {
				"x": 480,
				"y": 0
			},
			"data": {
				"blockName": "Each turn",
				"values": [],
				"useParam": true
			}
		},
		{
			"id": "turn",
			"type": "jsrunner",
			"position": {
				"x": 720,
				"y": 120
			},
			"data": {
				"blockName": "One turn",
				"value": "await new Promise((r) => setTimeout(r, 100));"
			}
		},
		{
			"id": "after",
			"type": "jsrunner",
			"position": {
				"x": 720,
				"y": 0
			},
			"data": {
				"blockName": "After the loop",
				"value": "await fetch(getConfig(\"E2E_SINK_URL\") + \"/ev?k=all&e=after\");"
			}
		},
		{
			"id": "done",
			"type": "response",
			"position": {
				"x": 960,
				"y": 0
			},
			"data": {
				"blockName": "Done",
				"httpCode": "200"
			}
		}
	],
	"edges": [
		{
			"id": "e-entry-start",
			"from": "entry",
			"to": "start",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-start-each",
			"from": "start",
			"to": "each",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-each-turn",
			"from": "each",
			"to": "turn",
			"fromHandle": "executor",
			"toHandle": "executor"
		},
		{
			"id": "e-each-after",
			"from": "each",
			"to": "after",
			"fromHandle": "source",
			"toHandle": "source"
		},
		{
			"id": "e-after-done",
			"from": "after",
			"to": "done",
			"fromHandle": "source",
			"toHandle": "source"
		}
	]
}
