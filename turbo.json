{
	"$schema": "https://turborepo.com/schema.json",
	"concurrency": "16",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"test": {
			"cache": false,
			"persistent": true
		},
		"typecheck": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"outputs": ["dist"]
		},
		"build:ui": {
			"outputs": [".next"],
			"dependsOn": ["^build"]
		},
		"build:standalone": {
			"outputs": ["dist"],
			"dependsOn": ["^build"]
		}
	}
}
