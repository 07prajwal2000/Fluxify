# ====================== ENVIRONMENT ======================
# Application runtime mode: development | production
ENVIRONMENT=development
# Node environment mode: development | production
NODE_ENV=development

# ====================== LICENSE ======================
# Set the edition in Instance Settings → License (non-commercial until you
# change it). Setting LICENSE_KEY here overrides the UI and makes it read-only:
# NON_COMMERCIAL, or a signed license key.
# LICENSE_KEY=
#
# Signed keys only verify against the issuer key baked into the build, and no
# issuer exists yet. To test them locally, mint one against a throwaway keypair
# and point this at its public half:
#   bun run --cwd packages/common license:mint -- --licensee acme --days 30
# LICENSE_ISSUER_KEY_PATH=.license/issuer.pub

# ====================== DATABASES ======================
# PostgreSQL connection string: postgres://{username}:{password}@{host}:{port}/{database}
PG_URL=postgres://postgres:postgres@localhost:5432/fluxify_alpha
# Database engine variant: postgres | pglite
DB_VARIANT=postgres
# Local storage directory path when using DB_VARIANT=pglite
DB_PGLITE_PATH=
# Redis cache and queue server host
REDIS_HOST=localhost
# Redis server port
REDIS_PORT=6379
# Redis authentication username (optional)
REDIS_USER=
# Redis authentication password (optional)
REDIS_PASS=

# ====================== EVENT BUS (NATS) ======================
# NATS server connection URL
NATS_URL=nats://localhost:4222
# NATS authentication token
NATS_TOKEN=fluxify_nats_token

# ====================== WORKER NODE ======================
# Trigger groups this worker runs, comma-separated. Unset runs every group.
# WORKER_GROUP_ID=
# Identity of this worker node, used as its liveness and license-slot key. The
# orchestrator sets it when it provisions a node; a hand-started worker
# generates a short random one.
# FLUXIFY_NODE_ID=

# ====================== ORCHESTRATOR ======================
# Only needed to run the orchestrator (`bun run --cwd apps/server orchestrator`),
# which creates worker containers from the claims an operator wrote.
# The one image it may create a container from. Required — it is the whole image
# allowlist, so nothing user-written can name an image.
# ORCHESTRATOR_WORKER_IMAGE=fluxify-worker-compiled:latest
# How it reaches the daemon. Default unix:///var/run/docker.sock. A Windows
# named pipe cannot be opened: on Docker Desktop, Settings → General → expose
# the daemon on tcp://localhost:2375, then set the value below.
# DOCKER_HOST=tcp://localhost:2375
# Network the workers it creates join (default fluxify_net).
# ORCHESTRATOR_NETWORK=fluxify_net
# How often it compares what is running against what should be (default 5000).
# ORCHESTRATOR_RECONCILE_INTERVAL_MS=5000
# ORCHESTRATOR_HEALTH_PORT=5800
# Admin seeds one catch-all claim when no claim exists, so a fresh instance
# serves traffic. Set false to start with no workers.
# ORCHESTRATOR_SEED_DEFAULT_CLAIM=true

# ====================== PORT CONFIG & SERVICE URLS ======================
# Next.js web frontend port
WEB_PORT=3000
# Main backend control-plane server port
SERVER_PORT=5500
# Dedicated background worker server port
WORKER_PORT=5600
# Local HTTP proxy server port
PROXY_PORT=8080
# AI Gateway service server port
AI_GATEWAY_PORT=8001
# Harness runs a single AI gateway worker executes at once (1-100)
HARNESS_CONCURRENT_JOBS=10
# Upstream worker address for proxy routing when using scale-out topology (e.g. worker:5600)
WORKER_UPSTREAM=
# Public hostname for production deployments (e.g. www.fluxify.rest)
HOSTNAME=localhost
# Main public server URL
SERVER_URL=http://localhost:8080
# Comma-separated trusted origins for CORS and Better Auth (e.g. http://localhost:8080)
TRUSTED_ORIGINS=http://localhost:8080

# ====================== SECURITY & AUTHENTICATION ======================
# Enable admin control-plane API endpoints (true | false)
ENABLE_ADMIN=true
# Run embedded worker inside standalone server process (true | false)
ENABLE_BUILTIN_WORKER=true
# Enable AI Gateway features and worker integration (true | false)
ENABLE_AI=true
# Master key for encryption (generate via `openssl rand -base64 32`)
MASTER_ENCRYPTION_KEY=ZlhiQmhaS3JSeG5qTDZoWlZMbTd1WDE3aFhvYVlUVjE=
# Live reload route definitions on save (true | false)
HOT_RELOAD_ROUTES=true
# Secret key used for signing Better Auth session tokens
BETTER_AUTH_SECRET=vWJkRKH7tUg31TxgMoknTGTBv4xYFjVM
# Base authentication URL for Better Auth callbacks
BETTER_AUTH_URL=http://localhost:8080
# Machine-to-machine system access key for automated API access
SYSTEM_ACCESS_KEY=2zhJ7KpBp4s6WECoCHsG3ss6SwZuldw6
# Disable npm package installations in execution environment (true | false)
DISABLE_NPM=true
# Default email address for initial admin user seed
SEED_USER_EMAIL=admin@company.com
# Default password for initial admin user seed
SEED_USER_PASSWORD=admin@123
# Default full name for initial admin user seed
SEED_USER_NAME=Admin user

# ====================== PATHS & FILES ======================
# File path to the documentation vector index binary file
DOCS_INDEX_FILE_PATH=../dist/docs-index.bin

# ====================== OPENTELEMETRY LOGGING ======================
# Service identifier for OpenTelemetry telemetry
OTLP_SERVICE_NAME=fluxify.server
# OTLP collector HTTP endpoint URL for log ingestion
OTLP_LOGS_ENDPOINT=http://localhost:5080/api/default/v1/logs
# HTTP header name for OTLP exporter authentication
OTLP_AUTH_HEADER_NAME=Authorization
# HTTP header value for OTLP exporter authentication (e.g. Basic ... or Bearer ...)
OTLP_AUTH_HEADER_VALUE=""
# Enable OpenTelemetry log exporter (true | false)
OTLP_LOGGER_ENABLED=true
# Telemetry log level threshold: info | warn | error
OTLP_LOGGER_LEVEL=info

# ====================== LLM TRACING ======================
# Enable OpenTelemetry tracing for LLM operations (true | false)
LLM_TRACING_ENABLED=true
# OTLP collector HTTP endpoint URL for LLM trace ingestion
LLM_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
# Additional HTTP headers for LLM trace exporter
LLM_OTLP_TRACES_HEADERS=""
# Sampling rate for LLM traces (0.0 to 1.0)
LLM_TRACING_SAMPLE_RATE=1

# ====================== DOCKER ======================
# Docker daemon socket or named pipe path
DOCKER_HOST="npipe:////./pipe/docker_engine"