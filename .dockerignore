# Dependencies (match nested workspace node_modules too, so host-platform
# native bindings never leak into the in-image install/bundle)
**/node_modules

# Build caches. **/ is required: a bare `dist` only matches the context root,
# which let a host-built apps/server/dist (standalone, telemetry, win32 addons)
# leak into every image.
**/.turbo
**/.next
**/dist
**/out

# IDE / Editor
.vscode
.idea
*.swp
*.swo

# Environment files
.env
.env.*
!env.example

# Git
.git
.gitignore

# Documentation & metadata (built inside Docker)
docs_index
mkdocs.yml
CHANGELOG.md
CONTRIBUTING.md
Readme.md
LICENSE
img

# Docker files (avoid recursive context)
docker-compose.yml
Caddyfile.local
Dockerfile.kit

# Misc
.llm
.prettierignore
settings.json