:8080 {
	# Vite's base only serves the trailing-slash form; redirect the bare path.
	@admin_ui_bare path /_/admin/ui
	handle @admin_ui_bare {
		redir * /_/admin/ui/ 308
	}

	# Admin UI: static SPA built by Vite with base /_/admin/ui/. try_files hands
	# client-routed deep links back to index.html instead of 404ing.
	handle /_/admin/ui* {
		uri strip_prefix /_/admin/ui
		root * /app/portal
		try_files {path} /index.html
		file_server
	}
	# AI gateway: the assistant API and the MCP server both live there.
	handle /_/admin/api/ai* {
		reverse_proxy localhost:8001
	}
	handle /_/admin/mcp* {
		reverse_proxy localhost:8001
	}
	handle /_/admin/api* {
		reverse_proxy localhost:5500
	}
	# User API traffic goes to the separate worker service.
	handle * {
		reverse_proxy {$WORKER_UPSTREAM}
	}
}
