# Single published port for the whole kit. Everything below is in-container.
:8080 {
    handle /_/admin/ui* {
        reverse_proxy localhost:3000
    }
    handle /_/admin/api/ai* {
        reverse_proxy localhost:8001
    }
    handle /_/admin/api* {
        reverse_proxy localhost:5500
    }
    # Everything else is user API traffic, served by the compiled worker.
    # A 502 here means the worker is not running — most likely
    # WORKER_PROJECT_ID is unset (see docker/kit/entrypoint.sh).
    handle * {
        reverse_proxy localhost:5600
    }
}
