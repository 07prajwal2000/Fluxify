# ====================== ENVIRONMENT ======================
# Application runtime mode: development | production
ENVIRONMENT=production
# Node environment mode: development | production
NODE_ENV=production

# ====================== BUNDLED vs EXTERNAL SERVICES ======================
# The kit image ships PostgreSQL, Valkey and NATS and starts them automatically.
# Each is SKIPPED when its connection variable below is set, which is exactly
# what this file does — so docker-compose.yml runs the external containers and a
# bare `docker run` (no env file) runs the bundled ones. Same image both ways.
#
#   PG_URL     set -> bundled PostgreSQL not started
#   REDIS_HOST set -> bundled Valkey not started
#   NATS_URL   set -> bundled NATS not started
#
# In bundled mode MASTER_ENCRYPTION_KEY / BETTER_AUTH_SECRET / SYSTEM_ACCESS_KEY
# are generated into /data/secrets.env on first boot if unset. Back that up:
# losing it means stored project credentials can no longer be decrypted.

# ====================== DATABASES ======================
# PostgreSQL connection string: postgres://{username}:{password}@{host}:{port}/{database}
PG_URL=postgres://postgres:postgres@postgres:5432/fluxify_alpha
# Database engine variant: postgres | pglite
DB_VARIANT=postgres
# Local storage directory path when using DB_VARIANT=pglite
DB_PGLITE_PATH=
# Redis cache and queue server host (Valkey container name)
REDIS_HOST=valkey
# Redis server port
REDIS_PORT=6379
# Redis authentication username (optional)
REDIS_USER=
# Redis authentication password (optional)
REDIS_PASS=

# ====================== EVENT BUS (NATS) ======================
# NATS server connection URL (NATS container name)
NATS_URL=nats://nats:4222
# NATS authentication token
NATS_TOKEN=fluxify_nats_token

# ====================== PORT CONFIG & SERVICE URLS ======================
# Next.js web frontend port
WEB_PORT=3000
# Main backend control-plane server port
SERVER_PORT=5500
# Port the compiled worker serves user API traffic on
WORKER_PORT=5600
# Port the compiled worker serves health/readiness on — probes go HERE, not 5600
WORKER_HEALTH_PORT=5601
# These two are the production worker's. The kit also starts a development worker
# (FLUXIFY_ENV=development) on 5602, health on 5603, and sets that variable for
# it alone. Never put FLUXIFY_ENV in this file: the production worker and the
# admin server read it too.
# The project the request worker serves. `*` (the default) serves every project
# and picks up new ones as you create them, with no restart. Set a project id to
# pin this worker to that project only. Projects without a subdomain share the
# base domain, so equal paths in two projects shadow each other under `*`.
WORKER_PROJECT_ID=*
# Close an unused database integration after this many seconds (default 450 = 7.5 minutes).
INTEGRATION_TIMEOUT_POLICY_IN_SEC=450
# Hard cap on an incoming request body, in kilobytes (default 8192 = 8 MB).
# Fluxify is an API server: for uploads, prefer a pre-signed object-storage URL.
WORKER_MAX_STREAM_SIZE=8192
# Most triggers one trigger group may hold (default 5). Each trigger is a queue the
# workers poll; raise it when workers run on machines that can poll more.
MAX_TRIGGERS_PER_GROUP=5
# Persistent sandboxes one user may keep in one project (default 20; 1-1000).
MAX_SANDBOX_PER_USER=20
# Per-worker bound for future async trigger/workflow execution.
ASYNC_EXECUTOR_MAX_IN_FLIGHT=10
ASYNC_EXECUTOR_MAX_QUEUE_DEPTH=100
ASYNC_EXECUTOR_DRAIN_TIMEOUT_MS=30000
# Local HTTP proxy server port (Caddy entrypoint)
PROXY_PORT=8080
# AI Gateway service server port
AI_GATEWAY_PORT=8001
# Agent runs one AI gateway worker executes at once (1-100)
AGENT_CONCURRENT_JOBS=10
# Ms an agent run may go without a heartbeat before it counts as dead (min 30000)
AGENT_RUN_STALE_MS=120000
# Traces of the AI assistant for Phoenix, Langfuse or another OpenInference viewer. Off by default.
LLM_TRACING_ENABLED=false
# Where traces go (Phoenix: http://localhost:6006/v1/traces)
LLM_OTLP_TRACES_ENDPOINT=
# Headers for that endpoint as key:value pairs split by ; (e.g. Authorization:Bearer abc)
LLM_OTLP_TRACES_HEADERS=
# Share of runs traced, 0 to 1
LLM_TRACING_SAMPLE_RATE=1
# false keeps prompts, messages and tool inputs/outputs out of traces (only metadata and token counts)
LLM_TRACING_RECORD_CONTENT=false
# Public hostname for production deployments (e.g. www.fluxify.rest)
HOSTNAME=0.0.0.0
# Main public server URL; Better Auth uses it as its base URL too
SERVER_URL=http://localhost:8080
# Comma-separated trusted origins for CORS and Better Auth (e.g. http://localhost:8080)
TRUSTED_ORIGINS=http://localhost:8080

# ====================== SECURITY & AUTHENTICATION ======================
# Enable admin control-plane API endpoints (true | false)
ENABLE_ADMIN=true
# The proxy's address as the admin reaches it, for sandboxes, the playground,
# call_route, Run and test suites. Leave it unset: the admin reaches the
# project's public address (the kit's own Caddy on port 8080), which already
# sends /_sandbox and /_/dev to the development worker. Set it only when the
# admin cannot reach that public address, for example
# PROXY_URL=http://localhost:8080 to point at the kit's own Caddy directly. It
# is the proxy, never a single worker.
# PROXY_URL=http://localhost:8080
# Days a recorded run (Execution history) is kept before it is deleted (default 30).
RECORDING_MAX_AGE_DAYS=30
# Days an audit log entry (Enterprise) is kept before it is deleted (default 30).
AUDIT_LOG_MAX_AGE_DAYS=30
# How long the admin waits for a worker to test or inspect a plugin integration,
# in milliseconds (default 15000).
INTEGRATION_WORKER_TIMEOUT_MS=15000
# Run the embedded worker inside the standalone server process (true | false).
# Keep this false: the kit runs the compiled worker as its own process.
ENABLE_BUILTIN_WORKER=false

# Kit ships no orchestrator: one process tree is one node, so there is nothing
# to claim or place. Leave this false — the claim API and the Orchestration tab
# are both gated on it. Independent of the license key.
ENABLE_ORCHESTRATION=false
# Enable AI Gateway features and worker integration (true | false)
ENABLE_AI=true
# Master key for encryption (generate via `openssl rand -base64 32`)
MASTER_ENCRYPTION_KEY=ZlhiQmhaS3JSeG5qTDZaWlZMbTd1WDE3aFhvYVlUVjE=
# Edition: set it in Instance Settings → License (non-commercial until you
# change it). LICENSE_KEY overrides the UI and makes it read-only.
# LICENSE_KEY=
# Live reload route definitions on save (true | false)
HOT_RELOAD_ROUTES=false
# Secret key used for signing Better Auth session tokens
BETTER_AUTH_SECRET=vWJkRKH7tUg31TxgMoknTGTBv4xYFjVM
# Machine-to-machine system access key for automated API access
SYSTEM_ACCESS_KEY=2zhJ7KpBp4s6WECoCHsG3ss6SwZuldw6
# Initial admin account. REQUIRED — a first boot with the bundled database
# refuses to start without both, because nothing else can create a login and the
# seeder skips silently on a malformed value. Password must be 8+ characters.
SEED_USER_EMAIL=admin@company.com
SEED_USER_PASSWORD=admin@123
# Default full name for initial admin user seed
SEED_USER_NAME=Admin user

# ====================== PATHS & FILES ======================
# File path to the documentation vector index binary file inside container
DOCS_INDEX_FILE_PATH=/app/ai-gateway/docs-index.bin

# ====================== OPENTELEMETRY LOGGING ======================
# Service identifier for OpenTelemetry telemetry
OTLP_SERVICE_NAME=fluxify.kit
# OTLP collector HTTP endpoint URL for log ingestion
OTLP_LOGS_ENDPOINT=http://localhost:5080/api/default/v1/logs
# HTTP header name for OTLP exporter authentication
OTLP_AUTH_HEADER_NAME=Authorization
# HTTP header value for OTLP exporter authentication
OTLP_AUTH_HEADER_VALUE=""
# Enable OpenTelemetry log exporter (true | false)
OTLP_LOGGER_ENABLED=true
# Telemetry log level threshold: info | warn | error
OTLP_LOGGER_LEVEL=info
